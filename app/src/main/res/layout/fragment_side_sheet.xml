<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_side_sheet"
    tools:context=".ui.page.SortOptionSideSheet">

    <View
        android:id="@+id/viewHandle"
        android:layout_width="4dp"
        android:layout_height="32dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_handle_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideDivide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.7" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSortOption"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/guideDivide"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/viewHandle"
        app:layout_constraintTop_toTopOf="parent"
        tools:listitem="@layout/item_sort_option_hori" />

    <TextView
        android:id="@+id/tvSortDesc"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:background="@color/dialog_back"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="@string/sort_option_desc"
        android:textColor="@color/dialog_text"
        android:textSize="@dimen/dialog_hori_text_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvSortAsc"
        app:layout_constraintStart_toEndOf="@id/viewHandle"
        app:layout_constraintTop_toBottomOf="@+id/guideDivide" />

    <TextView
        android:id="@+id/tvSortAsc"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/dialog_back"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="@string/sort_option_asc"
        android:textColor="@color/dialog_text"
        android:textSize="@dimen/dialog_hori_text_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvSortDesc"
        app:layout_constraintTop_toBottomOf="@+id/guideDivide" />

</androidx.constraintlayout.widget.ConstraintLayout>